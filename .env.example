APP_NAME="La Focaccia di Trevi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=Europe/Madrid

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos MySQL 8.4. Cada parte de la aplicación entra con su usuario:
# admin para las migraciones, web para la zona pública (por defecto) y
# gestion para la zona del personal. Las contraseñas se ponen al instalar.
DB_CONNECTION=web
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=focaccia_trevi
DB_BASE_PRUEBAS=focaccia_trevi_pruebas
DB_ADMIN_USUARIO=focaccia_admin
DB_ADMIN_CONTRASENA=
DB_WEB_USUARIO=focaccia_web
DB_WEB_CONTRASENA=
DB_GESTION_USUARIO=focaccia_gestion
DB_GESTION_CONTRASENA=
DB_INFORMES_USUARIO=focaccia_informes
DB_INFORMES_CONTRASENA=
# Desde dónde entran los usuarios: '%' con Docker, localhost en una instalación clásica
DB_USUARIOS_ANFITRION=%
# root: para crear el contenedor y para «php artisan basedatos:permisos»
DB_ROOT_USUARIO=root
DB_ROOT_CONTRASENA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En local, los correos se ven en Mailpit: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAILPIT_PUERTO_PANEL=8025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="pedidos@focaccia.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
